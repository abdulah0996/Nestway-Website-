PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/nestway_immigration
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-before-running-the-api
JWT_EXPIRES_IN=7d
SEED_ADMIN_FIRST_NAME=Nestway
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_EMAIL=admin@nestway.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-development-password
SEED_CONSULTANT_FIRST_NAME=Umar
SEED_CONSULTANT_LAST_NAME=Hanan Baig
SEED_CONSULTANT_EMAIL=umar@nestway.com
SEED_CONSULTANT_PASSWORD=replace-with-a-strong-development-password

# Lead email notifications (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=notifications@nestwayimmigration.com
EMAIL_PASSWORD=replace-with-an-smtp-app-password
EMAIL_FROM=Nestway Immigration <notifications@nestwayimmigration.com>
ADMIN_EMAIL=info@nestwayimmigration.com
EMAIL_TIMEZONE=Asia/Karachi
ADMIN_DASHBOARD_URL=http://localhost:5173/admin/leads
